# Copy to .env at the repo root. Every value is optional for local development.

# Claude API key. Leave empty to run the rules-only planner; the UI labels those plans.
ANTHROPIC_API_KEY=

# Model used for planning. For the faster, cheaper comparison run: claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# Set to false to turn the AI step off everywhere without removing the key
LLM_ENABLED=true

# Which model client plans: anthropic (needs a key), fixture (scripted answers for tests and E2E,
# no key or network), or off. Unset picks anthropic when a key is set, else off.
# LLM_MODE=fixture

# Timeout for one Claude call, and the budget for the whole plan request (at most 26000).
# API Gateway ends any request at 30 seconds, so the deadline stays well under that.
# LLM_MAX_ATTEMPTS is 2 or 3: the first answer plus one or two repairs.
LLM_TIMEOUT_MS=12000
PLAN_DEADLINE_MS=24000
LLM_MAX_ATTEMPTS=2

# Reasoning effort for models that support it (Sonnet 5): low, medium, high, xhigh, max
LLM_EFFORT=low

# Web. The web app reads this from apps/web/.env.local, not from this file.
# Unset means http://localhost:8787 under `next dev` and same origin in a build.
# NEXT_PUBLIC_API_BASE=http://localhost:8787

LOG_LEVEL=info

# The local API listens on 127.0.0.1 only. HOST=0.0.0.0 makes it reachable from other devices on
# your network, which could then spend your key.
# HOST=127.0.0.1

# Production only, set by the SAM template. Do not set these locally.
# ANTHROPIC_API_KEY_PARAM=/italy-planner/anthropic-api-key  (SSM SecureString with the API key)
# ORIGIN_VERIFY_PARAM=/italy-planner/origin-verify-secret  (SSM SecureString; CloudFront sends it
#   as the x-origin-verify header and the API rejects /api requests without it whenever it is set)
# GIT_SHA=<commit deployed>
